-- meta.42 -- the core of 42, interpreted by a 42 program.
--
-- THEOREM.md section 7.  `tm.42` answers "can 42 compute anything a computer
-- can"; this answers "can 42 compute what *42* computes", which is a sharper
-- question, because the answer has to be closed under the dagger.
--
-- The shape of the whole thing is
--
--     eval : env x (tm x val)  <->  env x (tm x val)
--
-- a relation on *states*.  `eval` leaves the environment and the term alone and
-- relates the value to its image, so a state carries its own program around --
-- which is what makes `eval!` mean something.  Run backwards, the very same
-- definition runs the encoded program backwards, and section 7.4 shows that
-- this agrees with daggering the encoded program instead.
--
-- Two things are worth noticing before the details.
--
-- **Nothing is implemented that could be inherited.**  `;` is interpreted by
-- `;`, `|` by `|`, `+` by `+`, `*` by `*`, and `^` by `^`.  `evstar` is one
-- line and needs no fixpoint machinery, no trampoline and no halting test,
-- because the meta-language already has the construct it is interpreting.
--
-- **No branch needs a predicate to separate it from its sibling.**  A
-- reversible language with an `if` has to supply an exit assertion so the
-- backward run can tell which branch it came from.  Here `evunion` is
-- `onleft | onright` and there is nothing to assert.

type val = mu V. 1 + (V + (V + (V x V)))
type nat = mu X. 1 + X

def mat       = dist ; (unitprod + unitprod)
def ctrl m    = mat ; (id + m) ; mat!

-- `condinv f` runs `f` when the flag is L and `f!` when it is R.  Its own
-- dagger is `condinv f!`, which is why one line per primitive covers both
-- directions instead of two.
def condinv f = mat ; (f + f!) ; mat!


-- ---------------------------------------------------------------------------
-- The universal value type.
--
-- 42's values are generated by 0, 1, + and x, so one recursive type holds all
-- of them: `L ()` is the unit, and the three other tags are the injections and
-- the pair.  These four are the constructors, written as programs.
-- ---------------------------------------------------------------------------

def vunit = inl                     -- 1        <-> val
def vinl  = inl ; inr               -- val      <-> val
def vinr  = inl ; inr ; inr         -- val      <-> val
def vpair = inr ; inr ; inr         -- val x val <-> val
def vsum  = (vinl + vinr) ; join    -- val + val <-> val


-- ---------------------------------------------------------------------------
-- The thirteen primitives, acting on encoded values.
--
-- Every one is inherited rather than implemented: the encoding is unwrapped,
-- the *meta-language's* primitive of the same name does the work, and the
-- result is wrapped again.  `unitsum` needs no work at all -- a value of
-- `0 + a` can only be an `R`, so the primitive is exactly the tag test.
--
-- `pcopy` and `pjoin` are the two that make this Rel rather than a groupoid,
-- and they are inherited too: object-level equality is meta-level `copy!`, and
-- object-level nondeterminism is meta-level `join!`.
-- ---------------------------------------------------------------------------

def pid        = id
def pzero      = zero
def pswapsum   = vsum! ; swapsum ; vsum
def passocsum  = vsum! ; (id + vsum!) ; assocsum ; (vsum + id) ; vsum
def punitsum   = vinr!
def pswapprod  = vpair! ; swapprod ; vpair
def passocprod = vpair! ; (id * vpair!) ; assocprod ; (vpair * id) ; vpair
def punitprod  = vpair! ; (vunit! * id) ; unitprod
def pdist      = vpair! ; (vsum! * id) ; dist ; (vpair + vpair) ; vsum
def pinl       = vinl
def pinr       = vinr
def pcopy      = copy ; vpair
def pjoin      = vsum! ; join


-- ---------------------------------------------------------------------------
-- Terms.
--
--   tm = mu T. (pname x flag)      -- a primitive, and whether it is inverted
--             + ((nat x flag)      -- a reference into the environment
--             + ((T x T)           -- t ; u
--             + ((T x T)           -- t | u
--             + ((T x T)           -- t + u
--             + ((T x T)           -- t * u
--             +   T ))))))         -- t^
--
-- This is `Term` from rel42/core.py with `Fun`, `App` and `Var` left out: they
-- are second-order, they are eliminated by `expand_env` before the evaluator
-- ever sees them (THEOREM.md 2.4), and so the core below is exactly the
-- language the Python evaluator runs.  A `type` line cannot be written for it,
-- because `tm` would have to mention `pname`, so the constructors are given as
-- programs instead -- which is what they are used as anyway.
-- ---------------------------------------------------------------------------

def tagprim  = inl
def tagref   = inl ; inr
def tagseq   = inl ; inr ; inr
def tagunion = inl ; inr ; inr ; inr
def tagsum   = inl ; inr ; inr ; inr ; inr
def tagprod  = inl ; inr ; inr ; inr ; inr ; inr
def tagstar  = inr ; inr ; inr ; inr ; inr ; inr

def n1  = inl
def n2  = inl ; inr
def n3  = inl ; inr ; inr
def n4  = inl ; inr ; inr ; inr
def n5  = inl ; inr ; inr ; inr ; inr
def n6  = inl ; inr ; inr ; inr ; inr ; inr
def n7  = inl ; inr ; inr ; inr ; inr ; inr ; inr
def n8  = inl ; inr ; inr ; inr ; inr ; inr ; inr ; inr
def n9  = inl ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr
def n10 = inl ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr
def n11 = inl ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr
def n12 = inl ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr
def n13 = inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr ; inr


-- ---------------------------------------------------------------------------
-- The syntactic dagger, written in 42.
--
-- This is `dagger` from rel42/core.py, line for line, and it needs no `dist`:
-- the cases of a sum are reached by `+` directly.  Two of the seven carry any
-- content at all.  `swapprod` is `Seq(s, u) -> Seq(dagger u, dagger s)`, the
-- contravariance; `swapsum` is `Prim(n, i) -> Prim(n, not i)`, the inv flag.
-- The other five are the functor going through.
--
-- Section 7.4's theorem is about this program and `eval` together.
-- ---------------------------------------------------------------------------

def dag = (id * swapsum)
        + ((id * swapsum)
        + ((swapprod ; (dag * dag))
        + ((dag * dag)
        + ((dag * dag)
        + ((dag * dag)
        +  dag)))))


-- ---------------------------------------------------------------------------
-- The environment.
--
-- `nthp` relates `(i, env)` to `((i, env), env[i])`: it produces the body
-- *without consuming the index or the environment*, which is the whole trick.
-- The obvious definition is `copy ; (id * nth)`, and it denotes the same
-- relation -- but its dagger is `(id * nth!) ; copy!`, and `nth!` on a term
-- enumerates every environment containing it, which does not terminate.
-- Written recursively instead, the dagger *checks* `env[i] = t` against an
-- index and an environment it already has.  Same relation, and only one of the
-- two runs; §7.5 comes back to this.
-- ---------------------------------------------------------------------------

def rebuild = (id * swapprod) ; assocprod ; swapprod ; (inr * inr)
def nzero   = unitprod ; inr! ; (copy * id) ; assocprod! ; (id * inr) ; swapprod
            ; ((unitprod! ; (inl * id)) * id)
def nsucc   = (id * inr!) ; assocprod ; (swapprod * id) ; assocprod!
            ; (id * nthp) ; assocprod ; (rebuild * id)
def nthp    = dist ; (nzero + nsucc) ; join


-- ---------------------------------------------------------------------------
-- Plumbing.
--
-- A point-free language has no variables, so rearranging a state is written
-- out.  Each of these is a bijection built from `assocprod` and `swapprod`
-- alone, so each is its own undoing under `!` and none of them can fail.
--
--   toframe  (env,(tm,val))              <-> (tm,(env,val))
--   mix4     ((a,b),(c,d))               <-> ((a,c),(b,d))
--   pframe   ((s,t),((e,e),(a,b)))       <-> ((s,(e,a)),(t,(e,b)))
--   vframe   ((s,t),(env,val))           <-> (val,((s,t),env))
--   prframe  ((pname,flag),(env,val))    <-> (pname,((flag,val),env))
-- ---------------------------------------------------------------------------

def toframe = assocprod ; (swapprod * id) ; assocprod!
def mix4    = assocprod! ; (id * assocprod) ; (id * (swapprod * id))
            ; (id * assocprod!) ; assocprod
def pframe  = (id * mix4) ; mix4
def vframe  = (id * swapprod) ; assocprod ; (swapprod * id) ; assocprod!
def prframe = assocprod! ; (id * (id * swapprod)) ; (id * assocprod)
def dagif   = swapprod ; ctrl dag ; swapprod

-- `sub` is `eval` on a subterm: the state is reframed, evaluated, and framed
-- back.  `onleft` and `onright` run it on the left or right subterm of a pair,
-- leaving the other alone.
def sub     = toframe! ; eval ; toframe
def onright = assocprod! ; (id * sub) ; assocprod
def onleft  = (swapprod * id) ; onright ; (swapprod * id)


-- ---------------------------------------------------------------------------
-- The seven branches.
-- ---------------------------------------------------------------------------

-- A primitive: pick it by name, and let `condinv` read the inv flag.
def pdisp = dist ; ((n1 * ((condinv pid) * id))
    + (dist ; ((n2 * ((condinv pzero) * id))
    + (dist ; ((n3 * ((condinv pswapsum) * id))
    + (dist ; ((n4 * ((condinv passocsum) * id))
    + (dist ; ((n5 * ((condinv punitsum) * id))
    + (dist ; ((n6 * ((condinv pswapprod) * id))
    + (dist ; ((n7 * ((condinv passocprod) * id))
    + (dist ; ((n8 * ((condinv punitprod) * id))
    + (dist ; ((n9 * ((condinv pdist) * id))
    + (dist ; ((n10 * ((condinv pinl) * id))
    + (dist ; ((n11 * ((condinv pinr) * id))
    + (dist ; ((n12 * ((condinv pcopy) * id))
    +          (n13 * ((condinv pjoin) * id))) ; join)) ; join)) ; join))
    ; join)) ; join)) ; join)) ; join)) ; join)) ; join)) ; join)) ; join)) ; join

-- A reference: look the body up, dagger it if the flag says so, evaluate it,
-- and put everything back.  The shape is `X ; eval ; X!`, so the backward
-- direction runs `nthp` and `dag` forwards too, and nothing is enumerated.
def refin = assocprod! ; (id * assocprod) ; (id * (swapprod * id)) ; (id * assocprod!)
          ; assocprod ; (nthp * id) ; assocprod! ; (id * assocprod)
          ; (id * (dagif * id)) ; (id * assocprod!) ; (id * (id * swapprod))
          ; (id * assocprod) ; assocprod! ; (id * assocprod)

def evprim  = prframe ; pdisp ; prframe! ; (tagprim * id)
def evref   = refin ; (id * (eval * id)) ; refin! ; (tagref * id)

-- `;` is interpreted by `;`: run the left subterm, then the right one.
def evseq   = onleft ; onright ; (tagseq * id)

-- `|` is interpreted by `|`.  No exit assertion, because none is needed.
def evunion = (onleft | onright) ; (tagunion * id)

-- `+` is interpreted by `+`: split on the value's own tag, run the matching
-- subterm, and put the tag back.
def evsum   = vframe ; (vsum! * id) ; dist
            ; ((vframe! ; onleft ; vframe ; (vinl * id))
             + (vframe! ; onright ; vframe ; (vinr * id))) ; join
            ; vframe! ; (tagsum * id)

-- `*` is interpreted by `*`.  The environment is duplicated by `copy` so that
-- both halves can see it, and reunited by `copy!` afterwards -- which succeeds
-- exactly because `eval` leaves environments alone.
def evprod  = (id * (id * vpair!)) ; (id * (copy * id)) ; pframe ; (sub * sub)
            ; pframe! ; (id * (copy! * id)) ; (id * (id * vpair)) ; (tagprod * id)

-- `^` is interpreted by `^`.  This is the line the whole design is for: since
-- `eval` fixes the environment and the term, the meta-level closure ranges over
-- exactly the value component, which is the object-level closure.
def evstar  = toframe! ; eval^ ; toframe ; (tagstar * id)

def body = dist ; (evprim
    + (dist ; (evref
    + (dist ; (evseq
    + (dist ; (evunion
    + (dist ; (evsum
    + (dist ; (evprod + evstar) ; join)) ; join)) ; join)) ; join)) ; join)) ; join

def eval = toframe ; body ; toframe!

-- Section 7.4's theorem: this denotes exactly `eval!`.
def conj = (id * (dag * id)) ; eval ; (id * (dag * id))


-- ---------------------------------------------------------------------------
-- Quoting, so that the thing can be driven by hand.
--
-- A quoted term is a program `1 <-> tm`, so quoting a compound term is just
-- composing the quotations.  `runq q` wraps a bool-to-bool program: it encodes
-- the input, pairs it with the empty environment and the quoted term, runs
-- `eval`, and unpacks the answer.  Because `runq q` is `load q ; eval ; (load
-- q)!`, its dagger is `load q ; eval! ; (load q)!` -- the same interpreter,
-- reading the same quotation, going the other way.
-- ---------------------------------------------------------------------------

def qprim n  = copy ; (n * inl) ; tagprim
def qinv n   = copy ; (n * inr) ; tagprim
def qseq a b = copy ; (a * b) ; tagseq
def qalt a b = copy ; (a * b) ; tagunion
def qstar a  = a ; tagstar

def qsum a b  = copy ; (a * b) ; tagsum
def qprod a b = copy ; (a * b) ; tagprod

def qid      = qprim n1
def qzero    = qprim n2
def qnot     = qprim n3
def qswap    = qprim n6
def qdist    = qprim n9
def qinl     = qprim n10
def qinr     = qprim n11
def qcopy    = qprim n12
def qjoin    = qprim n13
def quncopy  = qinv n12

-- `runw e q` interprets the quoted program `q` on values encoded by `e`.  The
-- encoder is a parameter because `val` is one type and the program's own type
-- is another: `e` is what says which values are meant.  `encbool` is the one
-- for `1 + 1`; `encpair` is the one for a pair of them, and any other is
-- written the same way, out of the four constructors above.
def nilenv   = inl
def encbool  = (vunit + vunit) ; vsum
def encpair  = (encbool * encbool) ; vpair
def loadw e q = e ; unitprod! ; (copy * id) ; ((nilenv * q) * id) ; assocprod!
def runw e q  = (loadw e q) ; eval ; (loadw e q)!
def runq q    = runw encbool q

-- `not`, interpreted.  Forwards it is `not`; backwards it is `not!`, and the
-- backward run is the same `eval` reading the same quotation.
def metanot    = runq qnot

-- `not ; not`, interpreted -- the identity, reached through two levels.
def metanotnot = runq (qseq qnot qnot)

-- prelude.42's `toggle = not^`, interpreted.  Nondeterminism survives the
-- encoding: one input, two answers.
def metatoggle = runq (qstar qnot)

-- `id | not`, interpreted.  The branch that needs no exit assertion.
def metaalt    = runq (qalt qid qnot)

-- `copy ; copy!`, interpreted: the partial identity, and the object-level
-- equality test running as meta-level `copy!`.
def metaeq     = runq (qseq qcopy quncopy)

-- `swapprod` on a pair of bools -- the same interpreter, a different encoder.
def metaswap   = runw encpair qswap

-- `join ; inl`, interpreted: forwards it throws the bit away and always
-- answers L; backwards it hands back both bits that could have led there, and
-- nothing at all for the answer it never produces.  MANUAL section 14.4 runs
-- this one both ways.
def metasink   = runq (qseq qjoin qinl)
