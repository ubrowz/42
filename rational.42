-- rational.42 -- exact rational arithmetic.
--
-- A rational is a pair (numerator, denominator), both naturals, denominator
-- at least 1.  Fractions are NOT kept in lowest terms, and that is a decision
-- rather than an oversight -- see the note on `reduceby` at the bottom.
--
-- Every operation here is exact.  Nothing is ever rounded, because rounding
-- is discarding and this language cannot discard.  As with the naturals, each
-- binary operation keeps one operand, which makes it injective and hands you
-- the inverse operation for free:
--
--   qadd : (a, b) |-> (b, a + b)        so  qsub = qadd!
--   qmul : (a, b) |-> (b, a * b)        so  qdiv = qmul!


-- ---------------------------------------------------------------------------
-- Borrowed from arith.42.
-- ---------------------------------------------------------------------------

def add (0, n)      <->  n
def add (m + 1, n)  <->  add (m, n) + 1

def mul (0, n)      <->  (n, 0)
def mul (m + 1, n)  <->  let (k, p) = mul (m, n) in (k, add (k, p))


-- ---------------------------------------------------------------------------
-- Rearranging.
--
-- `transpose` exchanges the two inner components of a pair of pairs.  Turned
-- round, its clause is the same clause with the names changed, so it is its
-- own inverse.
-- ---------------------------------------------------------------------------

def transpose ((a, b), (c, d))  <->  ((a, c), (b, d))

-- multiply, keeping BOTH operands:  (a, b) |-> ((a, b), a * b)
def mul2 (a, b)  <->  let (k, ab) = mul (a, b) in ((a, k), ab)


-- ---------------------------------------------------------------------------
-- Multiplication.   p/q * r/s  =  pr/qs
--
-- One line, and written point-free on purpose, because it shows what the
-- clauses are doing.  `transpose` turns ((p,q),(r,s)) into ((p,r),(q,s)) --
-- numerators together, denominators together.  `mul` on each side gives
-- ((r, pr), (s, qs)), because `mul` hands back its second operand.  And a
-- second `transpose` sorts that into ((r,s), (pr, qs)): the operand we kept,
-- beside the product.
-- ---------------------------------------------------------------------------

def qmul = transpose ; (mul * mul) ; transpose

def qdiv = qmul!


-- ---------------------------------------------------------------------------
-- Addition.   p/q + r/s  =  (ps + qr) / qs
--
-- The operands are used unevenly: p and r once each, q twice, s three times.
-- `mul` hands back its second operand, so s threads from one product into the
-- next as s1 and s2, and only q is used twice -- which is a copy.
-- ---------------------------------------------------------------------------

def qadd ((p, q), (r, s))  <->  let (s1, ps) = mul (p, s)  in
                                let (r1, qr) = mul (q, r)  in
                                let (s2, qs) = mul (q, s1) in
                                ((r1, s2), (add (ps, qr), qs))

def qsub = qadd!


-- ---------------------------------------------------------------------------
-- Equality, by cross-multiplication:  p/q = r/s  exactly when  ps = qr.
--
-- This is a filter -- it returns its input untouched or returns nothing -- so
-- the two cross products it computes have to be got rid of again afterwards.
-- The pattern for that is worth learning:
--
--   compute a thing, use it, then RECOMPUTE it backwards to cancel it.
--
-- `withps` pairs a fraction pair with p*s, keeping everything it used, so it
-- is injective and `withps!` removes a p*s again.  In `qeq`, the pattern
-- (n, n) succeeds only if the two cross products agree.
-- ---------------------------------------------------------------------------

def withps ((p, q), (r, s))  <->  let ((p1, s1), ps) = mul2 (p, s) in (((p1, q), (r, s1)), ps)
def withqr ((p, q), (r, s))  <->  let ((q1, r1), qr) = mul2 (q, r) in (((p, q1), (r1, s)), qr)

def cross x  <->  let (y, ps) = withps x in
                  let (z, qr) = withqr y in
                  (z, (ps, qr))

def qeq x  <->  let (y, (n, n)) = cross x in withps! (y, n)


-- ---------------------------------------------------------------------------
-- Scaling, and why fractions here are not in lowest terms.
--
-- `reduceby` divides both parts by a common factor you supply, and keeps the
-- factor.  Keeping it is what makes the operation injective, so `scaleby`
-- comes free.  The factor is used twice, once per division, and comes back
-- twice; the pattern (j, j) insists the two agree.
--
--   reduceby((6, 8), 2)  =  ((3, 4), 2)
--   scaleby((3, 4), 2)   =  ((6, 8), 2)
--
-- Now the interesting part: WHERE IS `reduce`?  There is none, and there
-- cannot be one.  Putting a fraction in lowest terms means dividing by the
-- gcd, and computing a gcd means running Euclid's algorithm, whose every step
-- throws away a quotient and keeps only a remainder.  This language cannot
-- throw anything away.  A gcd program written in 42 is therefore forced to
-- hand back the quotients it generated -- and that sequence is precisely the
-- continued-fraction expansion, from which the original fraction can be
-- rebuilt exactly.
--
-- So reduction cannot lose the thing it exists to lose.  Rather than fight
-- that, this file keeps fractions unreduced and compares them with `qeq`,
-- which is what "exact" costs here: 1/2 and 2/4 are different values that the
-- equality test agrees are the same number.
-- ---------------------------------------------------------------------------

def reduceby ((a, b), k)  <->  let ((a1, j), (b1, j)) = (mul! (k, a), mul! (k, b)) in
                               ((a1, b1), j)

def scaleby = reduceby!
