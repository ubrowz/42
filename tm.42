-- tm.42 -- a Turing machine, written as a single 42 program.
--
-- The machine increments a binary number.  It is here because it is the
-- smallest complete answer to "can 42 compute anything a computer can", and
-- because the shape it is written in is the shape *every* Turing machine takes
-- in 42:
--
--     init ; step^ ; final
--
-- `step` is one transition, `^` runs it as many times as it takes, and `final`
-- is a filter that only lets halted machines through.  Nothing else is needed:
-- no loop construct, no halting test.  See MANUAL section 11.


-- ---------------------------------------------------------------------------
-- The shapes.
--
--   sym  = 1 + 1                    L () is the bit 0, R () is the bit 1
--   bits = mu X. 1 + (sym x X)      a list of bits, least significant first
--   tape = bits x (sym x bits)      (everything left of the head, reversed;
--                                    the cell under the head; everything right)
--   conf = tape + (tape + tape)     the three control states, as labels
--
-- Only the first two are declared, because a `type` line is an abbreviation for
-- printing and cannot mention another one.
-- ---------------------------------------------------------------------------

type sym  = 1 + 1
type bits = mu X. 1 + ((1 + 1) x X)


-- ---------------------------------------------------------------------------
-- The control state is a *label*, not a component of a pair.
--
-- A machine with three states and a tape could be `state x tape`.  Making it
-- `tape + (tape + tape)` instead means `step` below has one clause per state
-- and nothing has to take the state out and put it back.
-- ---------------------------------------------------------------------------

def carry t   <->  L t          -- still carrying a 1 leftward
def rewind t  <->  R (L t)      -- carry done; walk the head back to the start
def halt t    <->  R (R t)      -- finished


-- ---------------------------------------------------------------------------
-- Working with the tape.
--
-- Move the head one cell right: the old cell joins the left list, and the first
-- cell of the right list becomes the new head.  `left` is not written out --
-- moving left is moving right backwards, which is one `!`.
-- ---------------------------------------------------------------------------

def right (l, (h, c : r))  <->  (h : l, (c, r))
def left = right!

-- The tape is a finite list, so running off the right end has to add a cell.
def stepover (l, (h, c : r))  <->  right (l, (h, c : r))
def stepover (l, (h, []))     <->  right (l, (h, [L ()]))


-- ---------------------------------------------------------------------------
-- The transition relation, one clause per row of the table.
--
--   carry :  head is 0  ->  write 1, start rewinding
--            head is 1  ->  write 0, move right, keep carrying
--   rewind:  more tape to the left  ->  move left
--            at the left end        ->  halt
--   halt  :  no transition at all, so `step` has no clause for it
--
-- Reading the head is a pattern and writing it is a term: `(l, (L (), r))`
-- reads a 0, and `(l, (R (), r))` on the right writes a 1.
-- ---------------------------------------------------------------------------

def carrystep (l, (L (), r))  <->  rewind (l, (R (), r))
def carrystep (l, (R (), r))  <->  carry (stepover (l, (L (), r)))

def rewindstep (c : l, hr)  <->  rewind (left (c : l, hr))
def rewindstep ([], hr)     <->  halt ([], hr)

def step (L t)      <->  carrystep t
def step (R (L t))  <->  rewindstep t


-- ---------------------------------------------------------------------------
-- The machine.  `load` puts a bit list on a tape with the head at the least
-- significant end; `halt!` is the filter that keeps only halted machines.
-- `run` stays point-free: `^` is the whole point of it.
-- ---------------------------------------------------------------------------

def load (h : r)  <->  ([], (h, r))
def unload = load!

def run = carry ; step^ ; halt!         -- tape to tape
def inc = load ; run ; unload           -- bit list to bit list


-- ---------------------------------------------------------------------------
-- Reading a bit list as a number, so the examples can be checked by eye.
-- `add` is section 9's, repeated here because each file stands on its own.
-- ---------------------------------------------------------------------------

def add (0, n)      <->  n
def add (m + 1, n)  <->  add (m, n) + 1

def double n  <->  add (n, n)

def value []           <->  0
def value (L () : bs)  <->  double (value bs)
def value (R () : bs)  <->  double (value bs) + 1

-- Increment, reported as a number, and increment run backwards.  Zero is the
-- one-bit list `[L ()]`: `load` needs a cell to put the head on, so the empty
-- list is not a tape.
def incval = inc ; value
def dec    = inc!
