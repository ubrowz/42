-- tour.42 -- a guided tour of 42, in eight steps.
--
-- Read this top to bottom.  Every definition is runnable:
--
--     ./42 tour <name> <value> [--backward]
--     ./42 show tour <name>
--
-- Definitions are written as clauses, `pattern <-> term`.  `show` prints each
-- one three ways: its clauses, the same clauses turned round (which is the
-- program run backwards), and the point-free 42 they compile to.
--
-- The one thing to internalise: there is no "forward" version of a program.
-- There is one definition, and two directions to read it.

type nat    = mu X. 1 + X
type list a = mu X. 1 + (a x X)


-- ===========================================================================
-- 1.  Bijections -- exactly one answer, both ways.
-- ===========================================================================
--
--   ./42 tour not "L ()"              ->  R ()
--   ./42 tour not "R ()" --backward   ->  L ()   (printed as 0; MANUAL section 3)
--
-- `not` moves whatever is under one label to the other.  Booleans are the
-- case where what is under the label is ().  It compiles to the one built-in
-- step `swapsum`.

def not (L x)  <->  R x
def not (R x)  <->  L x

def swap (a, b)  <->  (b, a)

-- Any rearrangement of a value's pieces is a bijection:
--
--   ./42 tour rot3 "(1, (2, 3))"      ->  (3, (1, 2))

def rot3 (a, (b, c))  <->  (c, (a, b))


-- ===========================================================================
-- 2.  Making structure out of nothing.
-- ===========================================================================
--
-- `[x]` needs an empty list to put `x` in front of, and nothing in the input
-- supplies one.  A constant like `[]` costs nothing to make, because there was
-- only ever one thing it could be; run backwards, it is checked, not invented.
--
--   ./42 tour single 7                ->  [7]
--   ./42 tour single "[7]" --backward ->  7

def single x  <->  [x]


-- ===========================================================================
-- 3.  Partial injections -- at most one answer.
-- ===========================================================================
--
-- A nat is  mu X. 1 + X:  zero is `L ()`, and n + 1 is `R n`.  So the
-- successor is the right label, and the predecessor takes it off again.
--
--   ./42 tour pred 3                  ->  2
--   ./42 tour pred 0                  ->  {}  -- empty, not an error: no clause
--                                             -- of `pred` matches 0

def succ n        <->  n + 1
def pred (n + 1)  <->  n


-- ===========================================================================
-- 4.  Union -- genuine choice.
-- ===========================================================================
--
-- `|` is the union of two programs: every answer of either.  `near` relates n
-- to both its neighbours, so it has two answers on most inputs and one on zero
-- (where `pred` contributes nothing).  This is also how a definition says that
-- two overlapping cases are both meant (MANUAL section 6).
--
--   ./42 tour near 5                  ->  4, 6
--   ./42 tour near 0                  ->  1

def near = pred | succ


-- ===========================================================================
-- 5.  Recursion.
-- ===========================================================================
--
-- One clause per shape of the input.  A list is empty or a cons cell, so
-- `append` has two clauses, and the second calls `append` on a shorter list.

def append ([], ys)    <->  ys
def append (x:xs, ys)  <->  x : append (xs, ys)

def rev []      <->  []
def rev (x:xs)  <->  append (rev xs, [x])

--   ./42 tour append "([1,2], [3,4])" ->  [1, 2, 3, 4]
--   ./42 tour rev "[1,2,3]"           ->  [3, 2, 1]
--   ./42 tour rev "[3,2,1]" -b        ->  [1, 2, 3]


-- ===========================================================================
-- 6.  Naming an inverse.
-- ===========================================================================
--
-- `append!` is already a program, so it can be given a name.  Forwards,
-- `split` enumerates every way to cut a list in two -- and nobody wrote it.
--
--   ./42 tour split "[1,2,3]"         ->  four splittings
--
-- `./42 show tour append` prints the clauses of `append` turned round, which
-- is what `split` does, read off the page:
--
--   append!  ys <-> ([], ys)
--   append!  (x : append (xs, ys)) <-> (x : xs, ys)

def split = append!

-- A call inside a pattern runs that program backwards.  `initlast` matches
-- any list that `append` could have made from some `xs` and a one-element
-- list, so it takes the last element off:
--
--   ./42 tour initlast "[1,2,3]"      ->  ([1, 2], 3)

def initlast (append (xs, [x]))  <->  (xs, x)


-- ===========================================================================
-- 7.  A test is a name used twice.
-- ===========================================================================
--
-- A test returns its input unchanged or returns nothing.  No special construct
-- is needed: a pattern that uses a name twice matches only when the two
-- places agree.  `palin` builds the pair (l, rev l) and matches it against
-- (m, m), which succeeds exactly when l reads the same backwards.
--
--   ./42 tour palin "[1,2,1]"         ->  [1, 2, 1]
--   ./42 tour palin "[1,2,3]"         ->  {}
--
-- It compiles to  copy ; id * rev ; copy!  -- duplicate, reverse one copy,
-- demand they still agree.

def palin l  <->  let (m, m) = (l, rev l) in m


-- ===========================================================================
-- 8.  A bigger recursion -- Towers of Hanoi.
-- ===========================================================================
--
-- The textbook Python is four lines:
--
--     def hanoi(n, src=0, aux=1, dst=2):
--         if n == 0: return []
--         return (hanoi(n-1, src, dst, aux)
--                 + [(src, dst)]
--                 + hanoi(n-1, aux, src, dst))
--
-- It hands the three pegs to each sub-call in a *different order*.  42
-- definitions take one value, not a list of arguments to reorder, so the
-- reordering becomes data: a rewrite of every move in the list a sub-call
-- returns.
--
-- A peg is  1 + (1 + 1):  L () is peg 0, R (L ()) is peg 1, R (R ()) is
-- peg 2.  The printer shows the first two as 0 and 1 and has no name for the
-- third, so peg 2 prints as `R R ()`.  `swap01` exchanges pegs 0 and 1;
-- `swap12` exchanges 1 and 2.

def swap01 (L x)      <->  R (L x)
def swap01 (R (L x))  <->  L x
def swap01 (R (R x))  <->  R (R x)

def swap12 (L x)      <->  L x
def swap12 (R (L x))  <->  R (R x)
def swap12 (R (R x))  <->  R (L x)

-- `relabelA` rewrites the first sub-call's moves into our peg names: its
-- destination is our auxiliary, so swap 1 and 2.  `relabelB` does the second
-- sub-call: swap 0 and 1.

def relabelA []             <->  []
def relabelA ((a, b) : ms)  <->  (swap12 a, swap12 b) : relabelA ms

def relabelB []             <->  []
def relabelB ((a, b) : ms)  <->  (swap01 a, swap01 b) : relabelB ms

-- `hanoi` itself.  `n` is used twice, once per sub-call, which is a copy.
--
--   ./42 tour hanoi 3
--     ->  [(0, R R ()), (0, 1), (R R (), 1), (0, R R ()), (1, 0), (1, R R ()),
--          (0, R R ())]                      -- i.e. 0->2, 0->1, 2->1, 0->2, ...
--
-- Backwards, `hanoi!` reads a move list and returns the n it solves, or {} if
-- the list is not the optimal solution for any n -- a checker nobody wrote.
-- Turned round, the two uses of `n` must agree, so both halves of the list
-- have to be solutions for the same n.
--
--   ./42 tour hanoi "[(0, 1), (0, R R ()), (1, R R ())]" -b   ->  2
--   ./42 tour hanoi "[(0, R R ()), (1, R R ())]"          -b   ->  {}

def hanoi 0      <->  []
def hanoi (n+1)  <->  append (relabelA (hanoi n), (L (), R (R ())) : relabelB (hanoi n))
